{
  "@context": "https://schema.org",
  "@type": "Book",
  "name": "{{book_title}}",
  "author": {
    "@type": "Person",
    "name": "{{author_name}}"
  },
  "hasPart": [
    {
      "@type": "Chapter",
      "name": "{{chapter_name}}",
      "url": "{{chapter_url}}",
      "position": "{{chapter_position}}"
    }
  ]
}
